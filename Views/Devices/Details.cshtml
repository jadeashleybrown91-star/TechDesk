@model TechDesk.Models.Device
@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>
<p><strong>Id:</strong> @Model.Id</p>
<p><strong>Asset Tag:</strong> @Model.AssetTag</p>
<p><strong>Category:</strong> @Model.Category</p>
<p><strong>Year:</strong> @Model.PurchaseYear</p>
<p><strong>Status:</strong> @(Model.IsOnLoan ? "On Loan" : "Available")</p>

<a href="/devices">Back to list</a>