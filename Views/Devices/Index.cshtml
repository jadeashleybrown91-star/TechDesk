@model List<TechDesk.Models.Device>
@{
    ViewData["Title"] = "Devices";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<h2>Devices</h2>

<form method="get" action="/devices" class="mb-3">
    <div class="row g-2">
        <div class="col-auto">
            <input type="text" name="name" value="@ViewBag.Name" placeholder="Part of name" class="form-control" />
        </div>
        <div class="col-auto form-check">
            <input type="checkbox" name="availableOnly" value="true"
                   class="form-check-input" id="availableOnly"
            @(ViewBag.AvailableOnly == true ? "checked" : "") />
            <label class="form-check-label" for="availableOnly">Available only</label>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
</form>

<p>@ViewBag.Count devices</p>

<div class="row">
    @foreach (var device in Model)
    {
        <partial name="_DeviceRow" model="device" />
    }
</div>

<p class="mt-3">
    <a href="/devices/add">Add a device</a>
</p>