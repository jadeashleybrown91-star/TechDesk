@{
    @model TechDesk.Models.Device

    ViewData["Title"] = "Delete Device";
}
<h2>Delete @Model.AssetTag @Model.Name?</h2>

<p>Are you sure you want to delete this device?</p>

<form method="post" action="/devices/delete/@Model.Id">
    <button type="submit" class="btn btn-danger">Yes</button>
    <a href="/devices" class="btn btn-secondary">No</a>
</form>
}
